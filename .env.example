# sudo docker run -p 8000:8000 chromadb/chroma
# ========================================
# Configuración del Agente Conversacional
# ========================================

# ENTORNO
# Opciones: development | production
NODE_ENV=development

# ========== LLM CONFIGURATION ==========
# Proveedor de LLM (openai | ollama)
# Defecto: ollama
LLM_PROVIDER=ollama

# Modelo a usar (depende del provider)
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4, etc.
# Ollama: llama2, neural-chat, mistral, etc.
LLM_MODEL=llama2

# SOLO PARA OPENAI
# Tu API key de OpenAI
# Obtén la tuya en: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=api-key-aqui

# SOLO PARA OLLAMA
# Host donde corre Ollama (defecto: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# ========== RAG/CHROMA ==========
# Host donde corre Chroma (defecto: localhost:8000)
# Si no está disponible, el agente continuará sin RAG
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ========== API SERVER ==========
# Puerto donde corre la API (defecto: 3000)
PORT=3000

# Log level (debug | info | warn | error)
# Defecto: debug en development, info en production
LOG_LEVEL=debug

# CORS - Link (comma-separated for multiple)
# Examples: http://localhost:5173,https://app.example.com
# Defecto: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Rate limiting - Optional (already configured in code)
# Max requests per time window for each endpoint
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
