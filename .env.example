# sudo docker run -p 8000:8000 chromadb/chroma
# ========================================
# Configuración del Agente Conversacional
# ========================================

# Proveedor de LLM (openai | ollama)
# Defecto: openai
LLM_PROVIDER=ollama

# Modelo a usar (depende del provider)
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4, etc.
# Ollama: llama2, neural-chat, mistral, etc.
LLM_MODEL=llama2

# ========== SOLO PARA OPENAI ==========
# Tu API key de OpenAI
# Obtén la tuya en: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=api-key-aqui


# ========== SOLO PARA OLLAMA ==========
# Host donde corre Ollama (defecto: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# ========== RAG/CHROMA ==========
# Host donde corre Chroma (defecto: localhost:8000)
# Si no está disponible, el agente continuará sin RAG
CHROMA_HOST=localhost
CHROMA_PORT=8000
